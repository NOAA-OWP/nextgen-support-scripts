# Definition of the suite 'nwm'
suite nwm
   edit ECF_HOME "/contrib/lfs/h1/owp/nwm/noscrub/SOMEBODY/test/packages/nwm-automation-scripts/nwm.v4.0.0/ecf"  # path to the package ecf directory
   edit ECF_INCLUDE "/contrib/lfs/h1/owp/nwm/noscrub/SOMEBODY/test/packages/nwm-automation-scripts/nwm.v4.0.0/ecf"
   edit ECF_OUT "/home/Zhengtao.Cui/test/tmp"
   #
   #enable this for SLURM
   #edit ECF_JOB_CMD 'sbatch %ECF_JOB% 1> %ECF_JOBOUT% 2>&1'
   #edit ECF_KILL_CMD 'scancel %ECF_RID%'
   edit CYC "$(echo %TIME%|cut -c1-2)"
   clock real    
   family hourly
     date *.*.*
     time 00:30 23:30 01:00
     # The Analysis Assimilation family, including inland, coastal, conus, Hawaii, Alaska, PRVI
     family nwm_analysis_assim
       # CONUS inland Ana
       task jnwm_conus_analysis_assim
         edit CASETYPE CONUS_ANALYSIS_ASSIM
         edit PRE_WORKDIR NONE
         edit ECF_JOBOUT '%ECF_OUT%/%ECF_NAME%.%ECF_TRYNO%.%ECF_DATE%_%TIME%'
     endfamily
     # The short range forecast family
     family nwm_short_range
       # CONUS inland short range forecast
       task jnwm_conus_short_range
         edit CASETYPE CONUS_SHORT_RANGE
         edit PRE_WORKDIR NONE
         edit ECF_JOBOUT '%ECF_OUT%/%ECF_NAME%.%ECF_TRYNO%.%ECF_DATE%_%TIME%'
         trigger ../nwm_analysis_assim/jnwm_conus_analysis_assim eq complete
     endfamily
   endfamily
   family daily
     date *.*.*
     time 18:30
     family nwm_extended_analysis_assim
       # CONUS inland extended AnA
       task jnwm_conus_extended_analysis_assim
         edit CASETYPE CONUS_EXT_ANALYSIS_ASSIM
         edit PRE_WORKDIR NONE
         edit ECF_JOBOUT '%ECF_OUT%/%ECF_NAME%.%ECF_TRYNO%.%ECF_DATE%_%TIME%'
     endfamily
   endfamily
   family da_preprocessing
     family fetch_raw_data
       task jnwm_fetch_usgs
         edit CASETYPE FETCH_USGS 
         time +00:01
       task jnwm_fetch_env_ca
         edit CASETYPE FETCH_ENVCA 
         cron 00:02 23:52 01:00
       task jnwm_fetch_usace
         edit CASETYPE FETCH_USACE 
         cron 00:05 23:55 01:00
       task jnwm_fetch_rfc
         edit CASETYPE FETCH_RFC 
         cron 00:10 23:55 01:00
     endfamily
     family preprocess
       cron 00:00 23:55 00:15
       # USGS and Env. Canada are preprocessed together so that their timeslices
       # can be merged in the same pass
       task jnwm_preprocess_usgs_n_envca
         edit CASETYPE PREPROCESS_USGS_N_ENVCA
       task jnwm_preprocess_usace
         edit CASETYPE PREPROCESS_USACE
       task jnwm_preprocess_rfc
         edit CASETYPE PREPROCESS_RFC
     endfamily
   endfamily
   family cleanup
     # Daily housekeeping: delete run/observation folders and dbn log files
     # older than CLEANUP_RETENTION_DAYS (default 3) from COMROOT, DCOMROOT and
     # DBNROOT/log. Runs once a day at a quiet hour.
     cron 01:00
     task jnwm_cleanup
       edit CASETYPE CLEANUP
   endfamily
endsuite
