#!/usr/bin/env bash

%manual
   Definition: This task runs the CONUS extended analysis assimilation for the inland formulations.
               The forecast jobs depend on the restart files generated by this task
   Operations: If this task fails, the forecast should still run using previous available restarts
%end

# For SLURM settings
##SBATCH -J CONUS_EXT_AnA
##SBATCH -o %ECF_JOBOUT%
##SBATCH -e %ECF_JOBOUT%.err
##SBATCH -t 00:60:00
##SBATCH --nodes 1
##SBATCH --nodelist=zhengtaocui-opertestbed-00015-1-0001
###SBATCH --exclusive
##SBATCH --ntasks-per-node=16

%include <head.h>
%include <model_envir.h>

# EXPORT list here
export cyc=`date --date="1 hour ago" -u +%%H`
export min=`date --date="1 hour ago" -u +%%M`

export PDY=`date --date="1 hour ago" -u +%%Y%%m%%d`

echo "I, %ECF_NAME%, am part of a suite that lives in %ECF_HOME%"
echo "CYC=%CYC%"

export CASETYPE=%CASETYPE%

${HOMEnwm}/jobs/JNWM

%include <tail.h>
